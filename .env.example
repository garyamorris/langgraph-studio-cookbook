# Copy to `.env` and fill in. `.env` is gitignored. Studio (`langgraph dev`) reads `.env` too (see langgraph.json).
# Lines that start with `# ` followed by NAME= are optional settings, shown with their defaults.

# --- OpenAI (needed for live runs only) -------------------------------------
# Leave empty for offline mode (deterministic stand-in models, no API calls, no cost).
# ANY non-empty value switches every example to LIVE mode, so only put a real key here.
OPENAI_API_KEY=

# Chat model used by every example. Models whose name contains "luna" are
# created without a temperature parameter (they do not accept one).
OPENAI_MODEL=gpt-6-luna
# Optional cheaper/faster model for high-volume nodes (falls back to OPENAI_MODEL).
# OPENAI_MODEL_FAST=

# Model for the Decisions API examples (client.decisions.create). Only
# gpt-6-luna is supported by the endpoint at the time of writing.
DECISIONS_MODEL=gpt-6-luna
# Seconds before a Decisions API request times out (the client also retries twice). Default: 60
# DECISIONS_TIMEOUT=60

# Embedding model for Studio's semantic memory store; live mode only (offline mode uses
# hashed bag-of-words vectors). Always requested at 256 dimensions. Default: text-embedding-3-small
# EMBEDDING_MODEL=text-embedding-3-small

# --- Data -------------------------------------------------------------------
# Directory holding the bundled datasets (support_tickets.csv, store.sqlite, kb/, ...).
# Default: the `data/` folder in this repo.
# DEEPDIVE_DATA_DIR=

# --- Offline mode ----------------------------------------------------------
# Set to 1 to run every example with deterministic stand-in models (no API
# calls, no cost) even when OPENAI_API_KEY is set. Offline is also the automatic
# fallback when OPENAI_API_KEY is empty or missing, and it is what the test-suite uses.
# DEEPDIVE_OFFLINE=1

# --- LangSmith tracing (optional, nice with Studio) ------------------------
# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=langgraph-deepdive
